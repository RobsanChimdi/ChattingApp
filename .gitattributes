@'
# Auto detect text files and perform LF normalization
* text=auto

# Text files - explicitly set to LF
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.csv text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Django templates
*.html text eol=lf

# Binary files - should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.avi binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
'@ | Out-File -FilePath ".gitattributes" -Encoding ASCII